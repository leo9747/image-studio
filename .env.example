# At least one key is required. Both can be set; the model list shows which
# models each key reaches.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Shared password for the UI. Blank means no authentication, which is only
# safe when bound to 127.0.0.1. Set this before exposing the app to a network:
# anyone who can open it can spend your API credits.
STUDIO_PASSWORD=

# Where generations are written. Two folders are created under it:
# generations/ for everything, favorites/ for the ones you star.
STUDIO_OUTPUT_DIR=./output

# Port to serve on. If it is taken, run.sh reports what holds it and moves to
# the next port in STUDIO_PORT_FALLBACKS — in a container that list defaults to
# the other published ports, since only published ports reach the host.
PORT=8080
STUDIO_PORT_FALLBACKS=
